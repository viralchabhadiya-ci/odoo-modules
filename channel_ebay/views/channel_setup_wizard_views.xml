<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="channel_setup_wizard_view_form_ebay" model="ir.ui.view">
        <field name="name">channel.setup.wizard.form.ebay</field>
        <field name="model">channel.setup.wizard</field>
        <field name="inherit_id" ref="channel_connector_base.channel_setup_wizard_view_form"/>
        <field name="arch" type="xml">
            <group name="credentials" position="inside">
                <field name="api_key" string="App ID (Client ID)" password="True" invisible="channel_type != 'ebay'"/>
                <field name="api_secret" string="Cert ID (Client secret)" password="True" invisible="channel_type != 'ebay'"/>
                <field name="ebay_refresh_token" password="True" invisible="channel_type != 'ebay'"/>
                <field name="ebay_sandbox" invisible="channel_type != 'ebay'"/>
            </group>
        </field>
    </record>
</odoo>
