<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_quickbooks" model="res.groups.privilege">
        <field name="name">QuickBooks</field>
        <field name="sequence">44</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_quickbooks_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_quickbooks"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Can connect the company to QuickBooks, choose what is sent and see the sync log.</field>
    </record>

    <record id="quickbooks_account_company_rule" model="ir.rule">
        <field name="name">QuickBooks connection: own companies</field>
        <field name="model_id" ref="model_quickbooks_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
