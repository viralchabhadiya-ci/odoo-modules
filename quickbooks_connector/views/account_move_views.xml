<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_quickbooks" model="ir.ui.view">
        <field name="name">account.move.form.quickbooks</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="quickbooks_state" invisible="1" groups="quickbooks_connector.group_quickbooks_manager"/>
                <button name="action_send_to_quickbooks" type="object" string="Send to QuickBooks"
                        groups="quickbooks_connector.group_quickbooks_manager"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund') or quickbooks_state == 'sent'"/>
            </xpath>
        </field>
    </record>

    <record id="view_tax_form_quickbooks" model="ir.ui.view">
        <field name="name">account.tax.form.quickbooks</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <field name="tax_scope" position="after">
                <field name="quickbooks_taxcode_id" groups="quickbooks_connector.group_quickbooks_manager"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="view_account_form_quickbooks" model="ir.ui.view">
        <field name="name">account.account.form.quickbooks</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="quickbooks_ref_id" groups="quickbooks_connector.group_quickbooks_manager"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
