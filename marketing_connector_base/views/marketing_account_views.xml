<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="marketing_account_view_list" model="ir.ui.view">
        <field name="name">marketing.account.list</field>
        <field name="model">marketing.account</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'error'" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="provider"/>
                <field name="state" widget="badge" decoration-success="state == 'connected'" decoration-danger="state == 'error'"/>
                <field name="synced_count" string="Lists synced"/>
                <field name="problem_count" string="Problems"/>
                <field name="last_sync"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="marketing_account_view_form" model="ir.ui.view">
        <field name="name">marketing.account.form</field>
        <field name="model">marketing.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_connect" type="object" string="Connect" class="btn-primary"
                            invisible="state == 'connected'" groups="marketing_connector_base.group_marketing_connector_manager"/>
                    <button name="action_connect" type="object" string="Check connection"
                            invisible="state != 'connected'" groups="marketing_connector_base.group_marketing_connector_manager"/>
                    <button name="action_sync_now" type="object" string="Sync now" class="btn-primary"
                            invisible="state != 'connected'"/>
                    <button name="action_resync_all" type="object" string="Resync everything"
                            invisible="state != 'connected'" confirm="Read and compare every contact again? Contacts that did not change are not sent."/>
                    <button name="action_register_webhooks" type="object" string="Switch on instant updates"
                            invisible="state != 'connected' or not supports_webhooks or webhooks_registered"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_problems" type="object" class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="problem_count == 0">
                            <field name="problem_count" widget="statinfo" string="Need attention"/>
                        </button>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <field name="connection_message" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state == 'error' or not connection_message">
                        <field name="connection_message" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Newsletter account"/></h1>
                    </div>
                    <group name="credentials">
                        <field name="provider" readonly="id"/>
                        <field name="api_key" password="True" required="state == 'draft'"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <div class="text-muted mb-3" invisible="state == 'connected' or not connect_help">
                        <field name="connect_help" nolabel="1"/>
                    </div>
                    <notebook>
                        <page string="Audiences / lists" name="lists" invisible="state == 'draft'">
                            <field name="link_ids" readonly="state != 'connected'">
                                <list editable="bottom" create="0" delete="0" decoration-muted="missing" decoration-danger="error">
                                    <field name="name"/>
                                    <field name="remote_count" string="There"/>
                                    <field name="odoo_count" string="In Odoo"/>
                                    <field name="sync"/>
                                    <field name="list_id" placeholder="Same name, created if needed" readonly="not sync and list_id"/>
                                    <field name="missing" column_invisible="True"/>
                                    <field name="error" string="Problem"/>
                                    <button name="action_sync_now" type="object" icon="fa-refresh" string="Sync this list" invisible="not sync or missing"/>
                                    <button name="action_view_problems" type="object" icon="fa-exclamation-triangle" string="Contacts with problems" invisible="problem_count == 0"/>
                                    <field name="problem_count" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Campaign results" name="campaigns" invisible="state == 'draft'">
                            <field name="campaign_ids" readonly="1">
                                <list default_order="sent_date desc">
                                    <field name="sent_date"/>
                                    <field name="name"/>
                                    <field name="list_name"/>
                                    <field name="emails_sent" sum="Sent"/>
                                    <field name="opens"/>
                                    <field name="open_rate" widget="percentage" string="Open rate" optional="show"/>
                                    <field name="clicks"/>
                                    <field name="click_rate" widget="percentage" string="Click rate" optional="show"/>
                                    <field name="unsubscribes"/>
                                    <field name="bounces"/>
                                </list>
                            </field>
                        </page>
                        <page string="Settings" name="settings">
                            <group>
                                <field name="auto_sync"/>
                                <field name="create_contacts"/>
                                <field name="last_sync"/>
                                <field name="supports_webhooks" invisible="1"/>
                                <field name="webhooks_registered" invisible="not supports_webhooks"/>
                                <field name="webhook_url" invisible="not supports_webhooks" widget="CopyClipboardChar"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="marketing_account_action" model="ir.actions.act_window">
        <field name="name">Marketing accounts</field>
        <field name="res_model">marketing.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect your email marketing account</p>
            <p>Keep your audiences, unsubscribes and campaign results in step with Odoo.</p>
        </field>
    </record>

    <record id="marketing_member_view_list" model="ir.ui.view">
        <field name="name">marketing.member.list</field>
        <field name="model">marketing.member</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="contact_id"/>
                <field name="email"/>
                <field name="link_id"/>
                <field name="sync_error"/>
            </list>
        </field>
    </record>

    <record id="marketing_member_view_form" model="ir.ui.view">
        <field name="name">marketing.member.form</field>
        <field name="model">marketing.member</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <group>
                        <field name="contact_id"/>
                        <field name="email"/>
                        <field name="link_id"/>
                        <field name="remote_subscribed"/>
                        <field name="sync_error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="marketing_campaign_view_list" model="ir.ui.view">
        <field name="name">marketing.campaign.list</field>
        <field name="model">marketing.campaign</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="sent_date"/>
                <field name="name"/>
                <field name="account_id"/>
                <field name="list_name"/>
                <field name="emails_sent" sum="Sent"/>
                <field name="opens"/>
                <field name="open_rate" widget="percentage" avg="Open rate"/>
                <field name="clicks"/>
                <field name="click_rate" widget="percentage" avg="Click rate"/>
                <field name="unsubscribes"/>
                <field name="bounces"/>
            </list>
        </field>
    </record>

    <record id="marketing_campaign_action" model="ir.actions.act_window">
        <field name="name">Campaign results</field>
        <field name="res_model">marketing.campaign</field>
        <field name="view_mode">list,pivot</field>
    </record>
</odoo>
