<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="channel_setup_wizard_view_form_woocommerce" model="ir.ui.view">
        <field name="name">channel.setup.wizard.form.woocommerce</field>
        <field name="model">channel.setup.wizard</field>
        <field name="inherit_id" ref="channel_connector_base.channel_setup_wizard_view_form"/>
        <field name="arch" type="xml">
            <group name="credentials" position="inside">
                <field name="shop_url" string="Website address" placeholder="https://shop.example.com" invisible="channel_type != 'woocommerce'" required="channel_type == 'woocommerce'"/>
                <field name="api_key" string="Consumer key" password="True" invisible="channel_type != 'woocommerce'"/>
                <field name="api_secret" string="Consumer secret" password="True" invisible="channel_type != 'woocommerce'"/>
            </group>
        </field>
    </record>
</odoo>
