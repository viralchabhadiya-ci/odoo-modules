<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="channel_setup_wizard_view_form_shopify" model="ir.ui.view">
        <field name="name">channel.setup.wizard.form.shopify</field>
        <field name="model">channel.setup.wizard</field>
        <field name="inherit_id" ref="channel_connector_base.channel_setup_wizard_view_form"/>
        <field name="arch" type="xml">
            <group name="credentials" position="inside">
                <field name="shop_url" string="Shop address" placeholder="my-shop.myshopify.com" invisible="channel_type != 'shopify'" required="channel_type == 'shopify'"/>
                <field name="api_key" string="Client ID" password="True" invisible="channel_type != 'shopify'"/>
                <field name="api_secret" string="Client secret" password="True" invisible="channel_type != 'shopify'"/>
                <field name="access_token" string="or Admin API access token" password="True" invisible="channel_type != 'shopify'"/>
            </group>
        </field>
    </record>
</odoo>
