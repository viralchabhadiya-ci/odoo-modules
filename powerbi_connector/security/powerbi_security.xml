<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_powerbi" model="res.groups.privilege">
        <field name="name">Power BI</field>
        <field name="sequence">42</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_powerbi_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_powerbi"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Can create feeds, choose what Power BI may read and issue access keys.</field>
    </record>
</odoo>
